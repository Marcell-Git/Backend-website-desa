# Server
APP_PORT=8080
APP_ENV=development

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rt26_db
DB_SSLMODE=disable

# JWT Authentication
JWT_SECRET=your-secret-key-here
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Backup Database
BACKUP_DIR=backups
PG_DUMP_PATH=pg_dump
PSQL_PATH=psql

# OCR Kartu Keluarga (Google Gemini API)
# Dapatkan API key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
